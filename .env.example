# MOTEVRA — Prisma Postgres + Auth.js / NextAuth
# Vercel's Prisma Postgres integration provides this variable.
# Keep the exact value generated by Vercel; do not replace it with a Neon URL.
DATABASE_URL="postgres://..."

AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://www.motevra.com"

# CJ Dropshipping — keep secrets server-side
CJ_API_KEY=""
CJ_LOGISTIC_NAME="CJPacket"
CJ_FROM_COUNTRY="CN"

# Google AdSense — set after your site is approved
NEXT_PUBLIC_ADSENSE_CLIENT=""

CRON_SECRET=""

# Use the exact Google email address that should have MOTEVRA admin access.
ADMIN_EMAILS="your-google-email@example.com"
