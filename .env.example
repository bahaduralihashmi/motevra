# MOTEVRA — Supabase + Auth.js / NextAuth
# Payment gateway credentials MUST NOT be placed in environment variables.
# Add JazzCash, Easypaisa, MCB eGate, Raast, Stripe, PayPal and bank credentials only from:
# Admin dashboard → Payment dashboard. They are encrypted in the database.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# Supabase anonymous/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Supabase service-role key — SERVER ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket used for MOTEVRA product images
SUPABASE_STORAGE_BUCKET="product-images"

# Supabase PostgreSQL connection string used by Prisma after migration
DATABASE_URL="postgresql://..."

AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://www.motevra.com"
NEXT_PUBLIC_ADSENSE_CLIENT=""
CRON_SECRET=""
ADMIN_EMAILS="your-google-email@example.com"
