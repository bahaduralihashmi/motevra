generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}
enum VehicleBodyType {
  SEDAN
  HATCHBACK
  SUV
  COUPE
  WAGON
  PICKUP
  VAN
  MPV
  OTHER
}
enum TyreSeason {
  SUMMER
  WINTER
  ALL_SEASON
}
enum ProductType {
  TYRE
  WHEEL
  ACCESSORY
  AUTO_PART
  BATTERY
  ELECTRONICS
  CAR_CARE
  OTHER
}
enum PaymentMethod {
  COD
  BANK_TRANSFER
  ONLINE
  JAZZCASH
  EASYPAISA
  MCB_EGATE
  RAAST
  STRIPE
  PAYPAL
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
enum SupplierType {
  MOTEVRA
  CJ_DROPSHIPPING
  ALIBABA
  OTHER
}
enum FulfillmentMethod {
  SELF
  SUPPLIER_API
  MANUAL
}
enum SupplierStatus {
  ACTIVE
  INACTIVE
}
enum CourierConnectionStatus {
  DISCONNECTED
  TESTING
  CONNECTED
  ERROR
}
enum CodSettlementStatus {
  PENDING
  SETTLED
  PARTIAL
  DISPUTED
}
enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}
enum PaymentProvider {
  JAZZCASH
  EASYPAISA
  MCB_EGATE
  RAAST
  STRIPE
  PAYPAL
  BANK_TRANSFER
  COD
  OTHER
}
enum TransactionStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}
enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}
enum LedgerEntryType {
  SALE
  SUPPLIER_COST
  SHIPPING_COST
  PAYMENT_FEE
  TAX
  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}
enum ShippingClass {
  STANDARD
  HEAVY
  BATTERY
  LIQUID
  ELECTRONICS
  TYRE
  WHEEL
  RESTRICTED
}
enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  role UserRole @default(CUSTOMER)
  addresses Address[]
  vehicles UserVehicle[]
  carts Cart[]
  orders Order[]
  reviews Review[]
  accounts Account[]
  sessions Session[]
  wishlist Wishlist?
  returns ReturnRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([provider,providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}

model Address {
  id String @id @default(cuid())
  userId String
  label String?
  country String
  region String?
  city String
  line1 String
  line2 String?
  postalCode String?
  phone String?
  isDefault Boolean @default(false)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model UserVehicle {
  id String @id @default(cuid())
  userId String
  vehicleVariantId String
  nickname String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  vehicleVariant VehicleVariant @relation(fields:[vehicleVariantId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([userId])
}

model VehicleMake {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  models VehicleModel[]
}

model VehicleModel {
  id String @id @default(cuid())
  makeId String
  name String
  slug String
  make VehicleMake @relation(fields:[makeId], references:[id], onDelete:Cascade)
  variants VehicleVariant[]
  @@unique([makeId,slug])
  @@index([makeId])
}

model VehicleVariant {
  id String @id @default(cuid())
  modelId String
  name String
  slug String
  yearFrom Int
  yearTo Int?
  engine String?
  bodyType VehicleBodyType?
  model VehicleModel @relation(fields:[modelId], references:[id], onDelete:Cascade)
  fitments VehicleFitment[]
  productFitments ProductFitment[]
  users UserVehicle[]
  @@unique([modelId,slug])
  @@index([modelId,yearFrom,yearTo])
}

model TyreSize {
  id String @id @default(cuid())
  width Int
  aspectRatio Int
  rimSize Int
  label String @unique
  tyres Tyre[]
  fitments VehicleFitment[]
  @@unique([width,aspectRatio,rimSize])
  @@index([width,aspectRatio,rimSize])
}

model VehicleFitment {
  id String @id @default(cuid())
  vehicleVariantId String
  tyreSizeId String
  position String?
  isOriginal Boolean @default(true)
  notes String?
  vehicleVariant VehicleVariant @relation(fields:[vehicleVariantId], references:[id], onDelete:Cascade)
  tyreSize TyreSize @relation(fields:[tyreSizeId], references:[id])
  @@unique([vehicleVariantId,tyreSizeId,position])
  @@index([tyreSizeId])
}

model Brand {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  imageUrl String?
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  imageUrl String?
  parentId String?
  parent Category? @relation("CategoryHierarchy", fields:[parentId], references:[id], onDelete:SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  priceRules PriceRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([parentId])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  sku String
  name String?
  price Decimal? @db.Decimal(12,2)
  stock Int @default(0)
  options Json?
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  orderItems OrderItem[]
  cartItems CartItem[]
  supplierVariants SupplierVariant[]
  @@index([productId])
  @@unique([sku])
}

model Product {
  id String @id @default(cuid())
  sku String @unique
  slug String @unique
  name String
  description String? @db.Text
  productType ProductType @default(OTHER)
  price Decimal @db.Decimal(12,2)
  salePrice Decimal? @db.Decimal(12,2)
  currency String @default("USD")
  status ProductStatus @default(DRAFT)
  stock Int @default(0)
  source String @default("MOTEVRA")
  fulfillmentMethod FulfillmentMethod @default(SELF)
  shippingClass ShippingClass @default(STANDARD)
  weight Float?
  supplierProducts SupplierProduct[]
  brandId String?
  categoryId String?
  brand Brand? @relation(fields:[brandId], references:[id], onDelete:SetNull)
  category Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  variants ProductVariant[]
  tyre Tyre?
  images ProductImage[]
  cartItems CartItem[]
  orderItems OrderItem[]
  reviews Review[]
  reviewRequests ReviewRequest[]
  wishlistItems WishlistItem[]
  returnItems ReturnItem[]
  fitments ProductFitment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([brandId])
  @@index([categoryId])
  @@index([status,productType])
  @@index([source,fulfillmentMethod])
}

model ProductImage {
  id String @id @default(cuid())
  url String
  alt String?
  position Int @default(0)
  productId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  @@index([productId,position])
}

model Tyre {
  id String @id @default(cuid())
  productId String @unique
  tyreSizeId String
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  size TyreSize @relation(fields:[tyreSizeId], references:[id])
  loadIndex Int?
  speedRating String?
  season TyreSeason?
  runFlat Boolean @default(false)
  warranty String?
  @@index([tyreSizeId])
}

model ProductFitment {
  id String @id @default(cuid())
  productId String
  vehicleVariantId String
  notes String?
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  vehicleVariant VehicleVariant @relation(fields:[vehicleVariantId], references:[id], onDelete:Cascade)
  @@unique([productId,vehicleVariantId])
  @@index([vehicleVariantId])
}

model Cart {
  id String @id @default(cuid())
  userId String?
  status CartStatus @default(ACTIVE)
  currency String @default("USD")
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  items CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status])
}

model CartItem {
  id String @id @default(cuid())
  cartId String
  productId String
  variantId String?
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  cart Cart @relation(fields:[cartId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id])
  variant ProductVariant? @relation(fields:[variantId], references:[id], onDelete:SetNull)
  @@index([cartId,productId])
  @@index([variantId])
}

model Country {
  id String @id @default(cuid())
  code String @unique
  name String
  currencyCode String
  active Boolean @default(true)
  currency Currency @relation(fields:[currencyCode], references:[code])
  shippingZones ShippingZoneCountry[]
  taxRules TaxRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([currencyCode])
}

model Currency {
  code String @id
  name String
  symbol String
  decimals Int @default(2)
  active Boolean @default(true)
  countries Country[]
  ratesFrom CurrencyRate[] @relation("RateFrom")
  ratesTo CurrencyRate[] @relation("RateTo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CurrencyRate {
  id String @id @default(cuid())
  fromCode String
  toCode String
  rate Decimal @db.Decimal(20,10)
  source String
  fetchedAt DateTime @default(now())
  from Currency @relation("RateFrom", fields:[fromCode], references:[code], onDelete:Cascade)
  to Currency @relation("RateTo", fields:[toCode], references:[code], onDelete:Cascade)
  @@unique([fromCode,toCode])
  @@index([toCode,fetchedAt])
}

model Supplier {
  id String @id @default(cuid())
  name String
  slug String @unique
  type SupplierType
  status SupplierStatus @default(ACTIVE)
  website String?
  apiBaseUrl String?
  externalAccountId String?
  products SupplierProduct[]
  warehouses SupplierWarehouse[]
  shippingMethods SupplierShippingMethod[]
  shippingRules ShippingRule[]
  supplierOrders SupplierOrder[]
  credentials SupplierCredential[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type,status])
}

model SupplierCredential {
  id String @id @default(cuid())
  supplierId String
  provider String
  encryptedData String @db.Text
  status String @default("DISCONNECTED")
  lastTestedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplier Supplier @relation(fields:[supplierId], references:[id], onDelete:Cascade)
  @@unique([supplierId,provider])
  @@index([supplierId,status])
}

model SupplierProduct {
  id String @id @default(cuid())
  productId String
  supplierId String
  externalProductId String?
  externalSku String?
  supplierCost Decimal @db.Decimal(12,2)
  supplierCurrency String @default("USD")
  active Boolean @default(true)
  lastSyncedAt DateTime?
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  supplier Supplier @relation(fields:[supplierId], references:[id], onDelete:Cascade)
  variants SupplierVariant[]
  inventories SupplierInventory[]
  @@unique([supplierId,productId])
  @@index([supplierId,externalProductId])
  @@index([supplierId,externalSku])
}

model SupplierVariant {
  id String @id @default(cuid())
  supplierProductId String
  productVariantId String?
  externalVariantId String?
  externalSku String?
  supplierCost Decimal @db.Decimal(12,2)
  supplierCurrency String @default("USD")
  productVariant ProductVariant? @relation(fields:[productVariantId], references:[id], onDelete:SetNull)
  supplierProduct SupplierProduct @relation(fields:[supplierProductId], references:[id], onDelete:Cascade)
  @@index([supplierProductId,externalVariantId])
  @@index([productVariantId])
}

model SupplierWarehouse {
  id String @id @default(cuid())
  supplierId String
  externalWarehouseId String?
  name String
  countryCode String?
  status WarehouseStatus @default(ACTIVE)
  supplier Supplier @relation(fields:[supplierId], references:[id], onDelete:Cascade)
  inventories SupplierInventory[]
  shipments Shipment[]
  @@index([supplierId,status])
}

model SupplierInventory {
  id String @id @default(cuid())
  supplierProductId String
  supplierWarehouseId String
  quantity Int @default(0)
  reserved Int @default(0)
  available Int @default(0)
  syncedAt DateTime?
  supplierProduct SupplierProduct @relation(fields:[supplierProductId], references:[id], onDelete:Cascade)
  warehouse SupplierWarehouse @relation(fields:[supplierWarehouseId], references:[id], onDelete:Cascade)
  @@unique([supplierProductId,supplierWarehouseId])
}

model SupplierShippingMethod {
  id String @id @default(cuid())
  supplierId String
  externalMethodId String?
  name String
  active Boolean @default(true)
  supplier Supplier @relation(fields:[supplierId], references:[id], onDelete:Cascade)
  @@index([supplierId,active])
}

model SupplierOrder {
  id String @id @default(cuid())
  orderId String
  supplierId String
  externalOrderId String?
  status String @default("PENDING")
  currency String @default("USD")
  supplierTotal Decimal @db.Decimal(12,2) @default(0)
  shippingCost Decimal @db.Decimal(12,2) @default(0)
  trackingNumber String?
  trackingUrl String?
  supplier Supplier @relation(fields:[supplierId], references:[id])
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  items SupplierOrderItem[]
  shipments Shipment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId])
  @@index([supplierId,status])
  @@unique([supplierId,externalOrderId])
}

model SupplierOrderItem {
  id String @id @default(cuid())
  supplierOrderId String
  orderItemId String
  quantity Int
  unitCost Decimal @db.Decimal(12,2)
  supplierOrder SupplierOrder @relation(fields:[supplierOrderId], references:[id], onDelete:Cascade)
  orderItem OrderItem @relation(fields:[orderItemId], references:[id], onDelete:Cascade)
  @@unique([supplierOrderId,orderItemId])
}

model ShippingZone {
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  countries ShippingZoneCountry[]
  rules ShippingRule[]
  @@index([active])
}

model ShippingZoneCountry {
  id String @id @default(cuid())
  zoneId String
  countryId String
  zone ShippingZone @relation(fields:[zoneId], references:[id], onDelete:Cascade)
  country Country @relation(fields:[countryId], references:[id], onDelete:Cascade)
  @@unique([zoneId,countryId])
}

model ShippingRule {
  id String @id @default(cuid())
  zoneId String
  name String
  shippingClass ShippingClass?
  supplierId String?
  minWeight Float?
  maxWeight Float?
  minOrderValue Decimal? @db.Decimal(12,2)
  maxOrderValue Decimal? @db.Decimal(12,2)
  price Decimal @db.Decimal(12,2)
  currency String
  active Boolean @default(true)
  zone ShippingZone @relation(fields:[zoneId], references:[id], onDelete:Cascade)
  supplier Supplier? @relation(fields:[supplierId], references:[id], onDelete:SetNull)
  @@index([zoneId,active])
  @@index([supplierId])
}

model TaxRule {
  id String @id @default(cuid())
  countryId String
  name String
  taxClass String?
  rate Decimal @db.Decimal(7,4)
  active Boolean @default(true)
  country Country @relation(fields:[countryId], references:[id], onDelete:Cascade)
  @@index([countryId,active])
}

model PaymentTransaction {
  id String @id @default(cuid())
  orderId String
  provider PaymentProvider
  status TransactionStatus @default(CREATED)
  providerTransactionId String?
  providerPaymentIntentId String?
  amount Decimal @db.Decimal(12,2)
  currency String
  baseAmount Decimal? @db.Decimal(12,2)
  baseCurrency String?
  exchangeRate Decimal? @db.Decimal(20,10)
  feeAmount Decimal? @db.Decimal(12,2)
  metadata Json?
  rawResponse Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  refunds Refund[]
  @@index([orderId,createdAt])
  @@index([provider,providerTransactionId])
}

model PaymentWebhookEvent {
  id String @id @default(cuid())
  provider PaymentProvider
  eventId String
  eventType String?
  payload Json?
  processed Boolean @default(false)
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@unique([provider,eventId])
  @@index([provider,createdAt])
}

model PaymentMethodConfig {
  id String @id @default(cuid())
  name String
  provider PaymentProvider
  type String @default("ONLINE")
  countries String[]
  currencies String[]
  encryptedCredentials String? @db.Text
  settings Json?
  instructions String? @db.Text
  mode String @default("LIVE")
  enabled Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([enabled,sortOrder])
  @@index([provider])
}

model Refund {
  id String @id @default(cuid())
  orderId String
  paymentTransactionId String?
  amount Decimal @db.Decimal(12,2)
  currency String
  reason String?
  status RefundStatus @default(PENDING)
  providerRefundId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  paymentTransaction PaymentTransaction? @relation(fields:[paymentTransactionId], references:[id], onDelete:SetNull)
  @@index([orderId,createdAt])
}

model CourierConnection {
  id String @id @default(cuid())
  name String
  provider String
  mode String @default("MANUAL")
  baseUrl String?
  encryptedCredentials String? @db.Text
  webhookSecret String?
  status CourierConnectionStatus @default(DISCONNECTED)
  lastTestedAt DateTime?
  lastError String?
  enabled Boolean @default(false)
  shipments Shipment[]
  settlements CodSettlement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([provider,status])
}

model CodSettlement {
  id String @id @default(cuid())
  orderId String
  shipmentId String?
  courierId String?
  status CodSettlementStatus @default(PENDING)
  grossAmount Decimal @db.Decimal(12,2)
  courierFee Decimal @db.Decimal(12,2) @default(0)
  otherDeductions Decimal @db.Decimal(12,2) @default(0)
  netAmount Decimal @db.Decimal(12,2)
  currency String @default("PKR")
  settlementReference String?
  settledAt DateTime?
  notes String? @db.Text
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  shipment Shipment? @relation(fields:[shipmentId], references:[id], onDelete:SetNull)
  courier CourierConnection? @relation(fields:[courierId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([orderId,status])
  @@index([courierId,status])
}

model Shipment {
  id String @id @default(cuid())
  orderId String
  supplierOrderId String?
  warehouseId String?
  courierId String?
  status ShipmentStatus @default(PENDING)
  carrier String?
  serviceName String?
  trackingNumber String?
  trackingUrl String?
  shippingCost Decimal @db.Decimal(12,2) @default(0)
  currency String @default("USD")
  shippedAt DateTime?
  deliveredAt DateTime?
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  supplierOrder SupplierOrder? @relation(fields:[supplierOrderId], references:[id], onDelete:SetNull)
  warehouse SupplierWarehouse? @relation(fields:[warehouseId], references:[id], onDelete:SetNull)
  courier CourierConnection? @relation(fields:[courierId], references:[id], onDelete:SetNull)
  codSettlements CodSettlement[]
  items ShipmentItem[]
  trackingEvents TrackingEvent[]
  @@index([orderId,status])
  @@index([trackingNumber])
}

model ShipmentItem {
  id String @id @default(cuid())
  shipmentId String
  orderItemId String
  quantity Int
  shipment Shipment @relation(fields:[shipmentId], references:[id], onDelete:Cascade)
  orderItem OrderItem @relation(fields:[orderItemId], references:[id], onDelete:Cascade)
  @@unique([shipmentId,orderItemId])
}

model TrackingEvent {
  id String @id @default(cuid())
  shipmentId String
  status String
  description String?
  location String?
  occurredAt DateTime
  shipment Shipment @relation(fields:[shipmentId], references:[id], onDelete:Cascade)
  @@index([shipmentId,occurredAt])
}

model PriceRule {
  id String @id @default(cuid())
  name String
  source String?
  productType ProductType?
  categoryId String?
  minCost Decimal? @db.Decimal(12,2)
  maxCost Decimal? @db.Decimal(12,2)
  markupPercent Decimal? @db.Decimal(7,4)
  fixedMarkup Decimal? @db.Decimal(12,2)
  minProfit Decimal? @db.Decimal(12,2)
  active Boolean @default(true)
  category Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  @@index([active])
}

model CommissionLedger {
  id String @id @default(cuid())
  orderId String
  type LedgerEntryType
  amount Decimal @db.Decimal(12,2)
  currency String
  description String?
  referenceId String?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  @@index([orderId,createdAt])
  @@index([type,createdAt])
}

model Wishlist {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  items WishlistItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id String @id @default(cuid())
  wishlistId String
  productId String
  wishlist Wishlist @relation(fields:[wishlistId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([wishlistId,productId])
}

model ReturnRequest {
  id String @id @default(cuid())
  orderId String
  userId String?
  status ReturnStatus @default(REQUESTED)
  reason String
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  items ReturnItem[]
  @@index([orderId,status])
}

model ReturnItem {
  id String @id @default(cuid())
  returnRequestId String
  orderItemId String
  productId String
  quantity Int
  returnRequest ReturnRequest @relation(fields:[returnRequestId], references:[id], onDelete:Cascade)
  orderItem OrderItem @relation(fields:[orderItemId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id])
  @@unique([returnRequestId,orderItemId])
}

model Order {
  id String @id @default(cuid())
  number String @unique
  userId String?
  guestEmail String?
  guestName String?
  guestPhone String?
  status OrderStatus @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  currency String @default("USD")
  baseCurrency String @default("USD")
  displayCurrency String @default("USD")
  exchangeRate Decimal? @db.Decimal(20,10)
  subtotal Decimal @db.Decimal(12,2)
  shippingTotal Decimal @db.Decimal(12,2) @default(0)
  taxTotal Decimal @db.Decimal(12,2) @default(0)
  total Decimal @db.Decimal(12,2)
  baseSubtotal Decimal? @db.Decimal(12,2)
  baseShippingTotal Decimal? @db.Decimal(12,2)
  baseTaxTotal Decimal? @db.Decimal(12,2)
  baseTotal Decimal? @db.Decimal(12,2)
  shippingName String
  shippingPhone String
  shippingCountry String
  shippingRegion String?
  shippingCity String
  shippingLine1 String
  shippingLine2 String?
  shippingPostalCode String?
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  items OrderItem[]
  reviews Review[]
  reviewRequests ReviewRequest[]
  paymentTransactions PaymentTransaction[]
  supplierOrders SupplierOrder[]
  shipments Shipment[]
  refunds Refund[]
  ledgerEntries CommissionLedger[]
  returns ReturnRequest[]
  codSettlements CodSettlement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([shippingCountry])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  productId String
  variantId String?
  quantity Int
  price Decimal @db.Decimal(12,2)
  currency String @default("USD")
  supplierCost Decimal? @db.Decimal(12,2)
  supplierCurrency String?
  shippingCost Decimal? @db.Decimal(12,2)
  taxAmount Decimal? @db.Decimal(12,2)
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id])
  variant ProductVariant? @relation(fields:[variantId], references:[id], onDelete:SetNull)
  supplierOrderItems SupplierOrderItem[]
  shipmentItems ShipmentItem[]
  returnItems ReturnItem[]
  @@index([orderId])
  @@index([productId])
}

model Review {
  id String @id @default(cuid())
  productId String
  userId String?
  orderId String
  rating Int
  title String?
  comment String @db.Text
  images Json?
  status ReviewStatus @default(PENDING)
  verifiedPurchase Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  @@unique([orderId, productId])
  @@index([productId,status,createdAt])
  @@index([userId,createdAt])
}

model ReviewRequest {
  id String @id @default(cuid())
  token String @unique
  orderId String
  productId String
  email String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  @@unique([orderId, productId])
  @@index([email,expiresAt])
}
